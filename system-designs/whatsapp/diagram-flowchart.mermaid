---
config:
  theme: redux-dark-color
---
flowchart TB
    client["Whatsappp app"]
    subgraph Backend Layer
        subgraph Whatsapp Server
            apigateway["API Gateway"]
            loadbalancer["Load Balancer"]
            chatservice["Chat Service"]
            kafka["Kafka"]
            database[("Database")]
            notficationservice["Notification Service"]
        end
        pushserver["Android Push Notification Server"]
    end
    
    client-- New message -->apigateway
    notficationservice-- Websocket(Client open) -->client
    
    apigateway-->loadbalancer-->chatservice
    chatservice-->kafka & database
    kafka-.->notficationservice
    
    notficationservice-- When client is closed -->pushserver
    pushserver-. Push Notification .->client
